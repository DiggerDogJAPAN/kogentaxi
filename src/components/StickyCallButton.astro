---
interface Props {
  lang?: 'ja' | 'en';
}

const { lang = 'ja' } = Astro.props;
---

<div class="mobile-sticky-btn">
  <a href="tel:0255-86-3141" class="sticky-tel-link">
    <span class="phone-pulse-icon">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="22" height="22">
        <path fill-rule="evenodd" d="M1.5 4.5a3 3 0 013-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 01-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 006.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 011.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 01-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5z" clip-rule="evenodd" />
      </svg>
    </span>
    <div class="sticky-text-wrapper">
      <span class="sticky-label">
        {lang === 'ja' ? 'お電話でのご予約・お問合せはこちら' : 'Call Kogen Taxi for Booking / Dispatch'}
      </span>
      <span class="sticky-number">0255-86-3141</span>
    </div>
  </a>
</div>

<style>
  .mobile-sticky-btn {
    display: none;
  }

  @media (max-width: 768px) {
    .mobile-sticky-btn {
      display: block;
      position: fixed;
      bottom: 0;
      left: 0;
      width: 100%;
      z-index: 998; /* Under the header mobile menu button but above all page elements */
      background: var(--color-bg-white);
      box-shadow: 0 -6px 24px rgba(43, 76, 126, 0.15);
      padding: 0.75rem 1rem;
      padding-bottom: calc(0.75rem + env(safe-area-inset-bottom));
      border-top: 1px solid var(--color-border);
      animation: slideUp 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    .sticky-tel-link {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      width: 100%;
      background-color: var(--color-accent);
      color: var(--color-bg-white);
      padding: 0.85rem 1.5rem;
      border-radius: var(--radius-md);
      font-weight: 700;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
      box-shadow: 0 4px 12px rgba(224, 109, 59, 0.35);
      transition: var(--transition);
    }

    .sticky-tel-link:active {
      background-color: var(--color-accent-dark);
      transform: scale(0.98);
    }

    .phone-pulse-icon {
      font-size: 1.5rem;
      display: inline-block;
      animation: pulse 1.8s infinite;
    }

    .sticky-text-wrapper {
      display: flex;
      flex-direction: column;
      text-align: left;
      line-height: 1.25;
    }

    .sticky-label {
      font-size: 0.75rem;
      font-weight: 500;
      opacity: 0.9;
      letter-spacing: 0.02em;
    }

    .sticky-number {
      font-size: 1.35rem;
      font-family: var(--font-sans);
      font-weight: 800;
      letter-spacing: 0.05em;
    }

    /* Keyframe Animations */
    @keyframes slideUp {
      from {
        transform: translateY(100%);
      }
      to {
        transform: translateY(0);
      }
    }

    @keyframes pulse {
      0% {
        transform: scale(1);
      }
      15% {
        transform: scale(1.2) rotate(-10deg);
      }
      30% {
        transform: scale(1.2) rotate(10deg);
      }
      45% {
        transform: scale(1.1) rotate(-3deg);
      }
      60% {
        transform: scale(1.2) rotate(3deg);
      }
      75% {
        transform: scale(1);
      }
      100% {
        transform: scale(1);
      }
    }
  }
</style>
