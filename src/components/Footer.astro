---
interface Props {
  lang?: 'ja' | 'en';
}

const { lang = 'ja' } = Astro.props;

// Shared unified navigation menu matching the header exactly
const links = [
  { href: '/', label: 'ホーム' },
  { href: '/fares/', label: 'タクシー料金' },
  { href: '/sightseeing/', label: '観光スポット' },
  { href: '/company/', label: '会社紹介' },
  { href: '/en/', label: 'ENGLISH' }
];
---

<footer class="footer">
  <div class="container footer-grid">
    <!-- Column 1: Brand Profile -->
    <div class="footer-column footer-brand-column">
      <a href="/" class="logo-link" aria-label="高原タクシー ホーム">
        <div class="logo-icon-wrapper">
          <img src="/images/logo.svg" alt="Kogen Taxi Logo" class="logo-svg" />
        </div>
        <div class="logo-text">
          <span class="logo-title">高原タクシー</span>
          <span class="logo-subtitle">KOGEN TAXI</span>
        </div>
      </a>
      <p class="footer-brand-desc">
        妙高高原エリアを中心に、安全・安心の送迎サービスをご提供しています。
      </p>
    </div>

    <!-- Column 2: Unified Navigation -->
    <div class="footer-column footer-links-column">
      <span class="column-title">ナビゲーション</span>
      <nav class="footer-nav-list" aria-label="フッターナビゲーション">
        {links.map(link => (
          <a href={link.href} class="footer-nav-item">
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- Column 3: Contact & Booking Details -->
    <div class="footer-column footer-contact-column">
      <span class="column-title">配車・ご予約</span>
      <div class="footer-contact-info">
        <a href="tel:0255-86-3141" class="footer-tel-link">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          0255-86-3141
        </a>
        <p class="contact-hours">営業時間 6:00〜23:30（年中無休）</p>
        <div class="footer-badges">
          <span class="footer-badge">妙高高原エリア対応</span>
         
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Copyright Bar -->
  <div class="container">
    <div class="footer-bottom-divider"></div>
    <div class="footer-bottom-row">
      <p class="copyright">&copy; {new Date().getFullYear()} KOGEN TAXI. All Rights Reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-bg-white);
    color: var(--color-text-medium);
    padding: 4.5rem 0 2.5rem 0;
    border-top: 1px solid var(--color-border);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr 1fr;
    gap: 4rem;
    align-items: flex-start;
    margin-bottom: 3rem;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Logo Links & Wrapper matching the Header style guide exactly */
  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .logo-icon-wrapper {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: transparent !important;
    padding: 0;
    transition: none;
  }

  .logo-svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: none;
  }

  /* Force logo to remain visually unchanged on hover, focus, active states */
  .logo-link:hover .logo-icon-wrapper,
  .logo-link:focus .logo-icon-wrapper,
  .logo-link:active .logo-icon-wrapper {
    background-color: transparent !important;
  }

  .logo-link:hover .logo-svg,
  .logo-link:focus .logo-svg,
  .logo-link:active .logo-svg {
    filter: none !important;
    opacity: 1 !important;
    transform: none !important;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
  }

  .logo-title {
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--color-primary);
    letter-spacing: 0.05em;
    line-height: 1.1;
  }

  .logo-subtitle {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-light);
    letter-spacing: 0.1em;
  }

  .footer-brand-desc {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-text-medium);
  }

  /* Column Titles */
  .column-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-dark);
    letter-spacing: 0.05em;
    border-bottom: 2px solid var(--color-border);
    padding-bottom: 0.5rem;
    margin-bottom: 0.25rem;
  }

  /* Navigation Link styles */
  .footer-nav-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .footer-nav-item {
    font-size: 0.9rem;
    color: var(--color-text-medium);
    font-weight: 600;
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .footer-nav-item:hover {
    color: var(--color-primary);
  }

  /* Contact and booking styles */
  .footer-contact-info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-tel-link {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 1.4rem;
    color: var(--color-accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: color 0.25s ease;
  }

  .footer-tel-link:hover {
    color: var(--color-accent-dark);
  }

  .contact-hours {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-medium);
  }

  /* Badges */
  .footer-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .footer-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-primary);
    background-color: rgba(22, 54, 87, 0.06);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    letter-spacing: 0.02em;
  }

  .footer-badge:last-child {
    color: var(--color-accent);
    background-color: rgba(224, 109, 59, 0.06);
  }

  /* Bottom Copyright Bar styles */
  .footer-bottom-divider {
    width: 100%;
    height: 1px;
    background-color: var(--color-border);
    margin: 2.5rem 0 1.75rem 0;
  }

  .footer-bottom-row {
    text-align: center;
  }

  .copyright {
    font-size: 0.8rem;
    color: var(--color-text-light);
    font-weight: 500;
  }

  /* Mobile responsiveness and adaptive columns */
  @media (max-width: 768px) {
    .footer {
      padding: 3.5rem 0 2rem 0;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      margin-bottom: 2rem;
    }

    .footer-column {
      gap: 1rem;
    }

    .footer-bottom-divider {
      margin: 2rem 0 1.5rem 0;
    }
  }
</style>
