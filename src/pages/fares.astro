<script>
  function initFaresDashboard() {
    const tabButtons = document.querySelectorAll('.tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');

    // Tab Switching
    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        
        // Deactivate active states
        tabButtons.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        tabPanels.forEach(p => p.classList.remove('active'));

        // Activate clicked state
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        const targetPanel = document.getElementById(targetId);
        if (targetPanel) {
          targetPanel.classList.add('active');
        }
      });
    });

    // Season Toggling (Standard vs Winter fares highlights)
    const seasonToggles = document.querySelectorAll('.season-btn');
    seasonToggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        const season = toggle.getAttribute('data-season');
        const parentPanel = toggle.closest('.tab-panel');
        
        if (!parentPanel) return;

        // Toggle active button style
        const buttons = parentPanel.querySelectorAll('.season-btn');
        buttons.forEach(b => b.classList.remove('active'));
        toggle.classList.add('active');

        // Toggle classes to toggle highlight styling
        if (season === 'winter') {
          parentPanel.classList.remove('season-summer');
          parentPanel.classList.add('season-winter');
        } else {
          parentPanel.classList.remove('season-winter');
          parentPanel.classList.add('season-summer');
        }
      });
    });

    // Set initial classes for highlight styles
    tabPanels.forEach(panel => {
      panel.classList.add('season-summer');
    });
  }

  // Support standard loads and Astro view transition swaps
  initFaresDashboard();
  document.addEventListener('astro:after-swap', initFaresDashboard);
</script>
